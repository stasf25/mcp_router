HOST_DOMAIN=127.0.0.1
HOST_PORT=8000

# Uncomment this to connect mcp_router to external containers (p.e. Dify)
# Before uncommenting create the docker network with:
# ```
# docker network create shared-network
# ```
#SHARED_NETWORK=true

#MCP_ROUTER_JWT_SECRET=Your-very-very-strong-JWT-secret
#MCP_ROUTER_API_KEY=Your-API-key-for-/run-endpoints
#BRIGHTDATA_TOKEN=your_brightdata_token