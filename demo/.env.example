# Base URL of the mcp_router instance (REST /run/* endpoints).
MCP_ROUTER_URL=http://localhost:8000/

# OpenAI-compatible chat model endpoint.
CHAT_MODEL_BASE_URL=https://api.openai.com/v1

# Model name, e.g. gpt-4o-mini or any OpenAI-compatible model id.
CHAT_MODEL_NAME=

# API key for the chat model.
CHAT_MODEL_API_KEY=
